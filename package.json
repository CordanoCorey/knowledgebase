{
  "name": "logeion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:component": "vite build --config vite.component.config.ts",
    "build:static": "npm run build && npm run build:component",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy --cmd \"npm run build:static\" --cmd-url-env-var-name VITE_CONVEX_URL",
    "context-expertise:status": "node scripts/rebuild-context-expertise-scoped-aggregates.mjs status",
    "context-expertise:rebuild:dry-run": "node scripts/rebuild-context-expertise-scoped-aggregates.mjs dry-run",
    "context-expertise:rebuild": "node scripts/rebuild-context-expertise-scoped-aggregates.mjs run",
    "context-expertise:quote-attribution:status": "node scripts/backfill-context-expertise-quote-attribution.mjs status",
    "context-expertise:quote-attribution:backfill:dry-run": "node scripts/backfill-context-expertise-quote-attribution.mjs dry-run",
    "context-expertise:quote-attribution:backfill": "node scripts/backfill-context-expertise-quote-attribution.mjs run",
    "context-expertise:legacy-aggregates:status": "node scripts/cleanup-context-expertise-legacy-aggregates.mjs status",
    "context-expertise:legacy-aggregates:cleanup:dry-run": "node scripts/cleanup-context-expertise-legacy-aggregates.mjs dry-run",
    "context-expertise:legacy-aggregates:cleanup": "node scripts/cleanup-context-expertise-legacy-aggregates.mjs run",
    "seed:scripture": "node scripts/seed-scripture.mjs",
    "seed:organizations": "node scripts/seed-organizations.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@convex-dev/auth": "^0.0.94",
    "@convex-dev/prosemirror-sync": "^0.2.4",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@vitejs/plugin-react": "latest",
    "convex": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "convex-test": "^0.0.53",
    "happy-dom": "^20.10.2",
    "typescript": "latest",
    "vitest": "^4.1.8"
  }
}
